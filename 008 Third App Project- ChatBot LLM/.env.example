# 1. Copy this file and name the copy ".env" (in the same folder).
# 2. Replace your-api-key-here with your real Gemini API key.
#    Get a free key at https://aistudio.google.com/apikey
# Never upload your .env file to GitHub. It's already listed in .gitignore.
GEMINI_API_KEY=your-api-key-here

# Optional: the model the app selects by default.
# The "-latest" alias always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
