# 1. Copy this file and name the copy ".env" (same folder).
# 2. Replace your_google_api_key_here with your real Gemini API key.
#    Get a free key at https://aistudio.google.com/apikey
# Never upload your .env file to GitHub. It's already listed in .gitignore.
GOOGLE_API_KEY=your_google_api_key_here

# Optional: the Gemini model the backend uses. Change it if Google retires this model.
GEMINI_MODEL=gemini-3.6-flash

# Optional: where the dashboard finds the backend (default shown).
FEEDBACK_API_URL=http://127.0.0.1:8000
