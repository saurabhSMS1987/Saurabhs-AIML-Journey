# 1. Copy this file and name the copy ".env" (in the same folder).
# 2. Replace your_actual_api_key_here with your real Gemini API key.
#    Get a free key at https://aistudio.google.com/apikey
# Never upload your .env file to GitHub. It's already listed in .gitignore.
GEMINI_API_KEY=your_actual_api_key_here

# Optional: which Gemini model to use. Change this if Google retires the model.
GEMINI_MODEL=gemini-3.6-flash
